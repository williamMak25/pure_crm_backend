# Copy to .env and change the secrets.

# --- App ---
APP_NAME=PURE ERP API
LITESTAR_DEBUG=false
API_PREFIX=/api
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated. The SvelteKit dev server runs on 5173.
ALLOWED_CORS_ORIGINS=http://localhost:5173
# true in production (HTTPS only)
COOKIE_SECURE=false
# Set to .example.com when the API and the app run on sibling subdomains
# COOKIE_DOMAIN=

# --- Database ---
# Used when running the API on your machine (uv run app run). Docker overrides this with host "db".
DATABASE_URL=postgresql+asyncpg://pure:pure@localhost:5434/pure_erp
POSTGRES_USER=pure
POSTGRES_PASSWORD=pure
POSTGRES_DB=pure_erp
POSTGRES_HOST_PORT=5434
API_HOST_PORT=8100

# --- First admin (created by the migrate container / `app seed` if missing) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Administrator
